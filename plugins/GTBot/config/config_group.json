{
  "default": {
    "chat_model": {
      "model": "l-codex2/gpt-5.4",
      "maximum_number_of_incoming_messages": 40,
      "max_message_length": 200,
      "behavioral_prompt": "行为提示词/默认_优化版.txt",
      "character_prompt": "角色提示词/天天2_优化版.md",
      "memory": {
        "notepad_max_entries": 15,
        "notepad_retention_seconds": 600
      },
      "send_timing": {
        "base_interval_seconds": 0.4,
        "per_char_seconds": 0.02,
        "jitter_seconds": 0.15,
        "max_interval_seconds": 3.0,
        "non_text_equivalent_chars": {
          "image": 30,
          "at": 4,
          "face": 2,
          "reply": 6
        }
      },
      "max_concurrent_responses_per_group": 1,
      "max_total_concurrent_responses": 5,
      "rejection_emoji_id": 10060,
      "max_tool_calls_per_turn": 20,
      "recursion_limit": 50,
      "processing_emoji_id": 10024,
      "completion_emoji_id": 127881,
      "first_token_emoji_id": 74,
      "thinking_emoji_id": -1,
      "silent_emoji_id": 75,
      "api_timeout_sec": 240,
      "first_token_timeout_sec": 30,
      "cost": {
        "enabled": true,
        "base_currency": "CNY",
        "provider_usage_rules": {
          "ds": {
            "input_tokens_path": "usage.prompt_cache_miss_tokens",
            "output_tokens_path": "usage.completion_tokens",
            "cache_read_tokens_path": "usage.prompt_cache_hit_tokens",
            "request_id_path": "id",
            "streaming": {
              "input_tokens_path": "input_tokens",
              "output_tokens_path": "output_tokens",
              "cache_read_tokens_path": "input_token_details.cache_read",
              "request_id_path": "",
              "input_tokens_include_cache_read": true
            }
          }
        }
      },
      "chat_opt_out": {
        "enabled": true,
        "rules": [
          {
            "id": "hash_boundary_opt_out",
            "enabled": true,
            "type": "expr",
            "value": "normalized_text.startswith('#') or normalized_text.endswith('#')"
          }
        ]
      },
      "continuation": {
        "enabled": true,
        "window_seconds":  30,
        "debounce_seconds":  3,
        "scope": "all",
        "analyzer_model": "h/gpt-oss-low",
        "analyzer_parameters": {
          "stream": false
        },
        "max_pending_messages": 8,
        "max_accumulated_messages": 12,
        "pre_history_messages": 6,
        "max_analyzer_context_messages": 40
      }
    },
    "user_profile": {
      "max_descriptions": 10,
      "max_description_char_length": 500
    },
    "message_format_placeholder": "[[$time_M]-[$time_d] [$time_h]:[$time_m]:[$time_s]] [$user_name]([$user_id], [$message_id]):[$message]"
  }
}
